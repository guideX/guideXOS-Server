say 'RX14_NATIVE_NUMERIC_START'
say 'ABS:' abs('-12.5')
say 'SIGN:' sign('-.25')
say 'MAXMIN:' max('1.2','1.19') min('9','2')
say 'TRUNC:' trunc('123.456',2)
say 'FORMAT:' format('1234567',,2,2,3)
say 'DATATYPE:' datatype('12.5','N') datatype('Ab9','A')
say 'SYMBOL:' symbol('NOT_SET')
say 'XRANGE:' xrange('A','E')
say 'RX14_NATIVE_NUMERIC_DONE'
exit 0
