<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <LinkerSubsystem>NATIVE</LinkerSubsystem>
    <EntryPointSymbol>ManagedMain</EntryPointSymbol>
    <LangVersion>latest</LangVersion>
    <SelfContained>true</SelfContained>
    <HostLogProofMode Condition="'$(HostLogProofMode)' == ''">NonAllocating</HostLogProofMode>
    <BaseOutputPath>..\..\..\out\dotnet\managed-hostlog\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>..\..\..\out\dotnet\managed-hostlog\obj\</BaseIntermediateOutputPath>
    <HostLogProofMapPath Condition="'$(HostLogProofMapPath)' == ''">$(MSBuildProjectDirectory)\..\..\..\out\dotnet\managed-hostlog\artifacts\HostLogProof.map</HostLogProofMapPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'Allocating'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_ALLOCATING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'FirstRealAllocation'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_FIRST_REAL_ALLOCATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'FirstRefill'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_FIRST_REFILL_ALLOCATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'SegmentBoundary'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_SEGMENT_BOUNDARY_ALLOCATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'SegmentTransition'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_SEGMENT_TRANSITION_ALLOCATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'FirstCollectionBoundary'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_FIRST_COLLECTION_BOUNDARY_ALLOCATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'ShortWeakLive'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_FIRST_COLLECTION_BOUNDARY_ALLOCATION;HOSTLOGPROOF_SHORT_WEAK_LIVE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'ShortWeakDead'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_FIRST_COLLECTION_BOUNDARY_ALLOCATION;HOSTLOGPROOF_SHORT_WEAK_DEAD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'FirstNonNullRoot'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_FIRST_COLLECTION_BOUNDARY_ALLOCATION;HOSTLOGPROOF_FIRST_NON_NULL_ROOT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'FirstNonNullOldO'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_FIRST_COLLECTION_BOUNDARY_ALLOCATION;HOSTLOGPROOF_FIRST_NON_NULL_ROOT;HOSTLOGPROOF_FIRST_NON_NULL_OLD_O</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'ThreadStaticPrimitive'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_THREAD_STATIC_PRIMITIVE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'ThreadStaticReference'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_THREAD_STATIC_REFERENCE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'ThreadStaticCombined'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_THREAD_STATIC_COMBINED</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HostLogProofMode)' == 'Repeated'">
    <DefineConstants>$(DefineConstants);HOSTLOGPROOF_ALLOCATING;HOSTLOGPROOF_REPEATED_ALLOCATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="9.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <LinkerArg Include="/fixed /base:0x10000000 /map:&quot;$(HostLogProofMapPath)&quot;" />
    <LinkerArg Include="/INCLUDE:ManagedMain" />
    <LinkerArg Include="/EXPORT:guideXosManagedArrayHostLog" Condition="'$(HostLogProofMode)' == 'Allocating'" />
  </ItemGroup>

  <ItemGroup>
    <NativeLibrary Include="$(HostLogProofRuntimeSupportObj)" Condition="'$(HostLogProofRuntimeSupportObj)' != '' and Exists('$(HostLogProofRuntimeSupportObj)')" />
    <NativeLibrary Include="$(HostLogProofRuntimePackObj)" Condition="'$(HostLogProofRuntimePackObj)' != '' and Exists('$(HostLogProofRuntimePackObj)')" />
    <NativeLibrary Include="$(HostLogProofRuntimePackProbeObj)" Condition="'$(HostLogProofRuntimePackProbeObj)' != '' and Exists('$(HostLogProofRuntimePackProbeObj)')" />
  </ItemGroup>
</Project>
