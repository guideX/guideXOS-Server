message = "guideXOS REXX scripting"
say left(message,8)
say right("42",5,"0")
say insert(" native","REXX scripting",4)
say overlay("ABC","12345",2)
say delstr("abcdef",3,2)
say delword("one two three",2,1)
say subword("one two three",2)
say wordindex(message,3)
say wordlength(message,2)
say lastpos("a","banana")
exit 0

