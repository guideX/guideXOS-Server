# Itanium (IA-64) Architecture Build Configuration
#
# Targets IA-64 / Itanium.  This configuration is not yet qualified by a
# target build or simulator run.
#
# Copyright (c) 2026 guideXOS Server
#

# Toolchain: try ia64-elf first, then ia64-linux-gnu.
ifeq ($(OS),Windows_NT)
    CXX := ia64-elf-g++
    AS  := ia64-elf-as
    LD  := ia64-elf-ld
else
    ifneq ($(shell which ia64-elf-g++ 2>/dev/null),)
        CXX := ia64-elf-g++
        AS  := ia64-elf-as
        LD  := ia64-elf-ld
    else ifneq ($(shell which ia64-linux-gnu-g++ 2>/dev/null),)
        CXX := ia64-linux-gnu-g++
        AS  := ia64-linux-gnu-as
        LD  := ia64-linux-gnu-ld
    else
        CXX := ia64-elf-g++
        AS  := ia64-elf-as
        LD  := ia64-elf-ld
    endif
endif

# Architecture-specific flags
# Linux-target GCC uses the LP64 ABI by default; -mlp64 is HP-UX-specific.
# GAS receives its supported -mlp64 flag explicitly for the assembly source.
# -mlittle-endian        : force little-endian compiler output
# -mconstant-gp        : one link-time GP value for this single-image kernel
# -xexplicit            : preserve explicit stop markers and check dependencies

# The default profile reserves every allocatable FP register because the
# kernel has no async interrupt or thread-switch FP save/restore path. GCC
# 13.5 currently ICEs on integer high-part multiply with that reservation.
# The separate compile-only profile frees the ABI scratch ranges f6-f15 and
# f32-f127 while keeping callee-saved f2-f5 and f16-f31 fixed. Its ELF is not
# runtime-qualified and the IA-64 runner rejects it.
IA64_FP_PROFILE ?= runtime
ifeq ($(IA64_FP_PROFILE),runtime)
    ARCH_CFLAGS := -mlittle-endian -mconstant-gp -mfixed-range=f2-f127 -Wa,-xexplicit
    ARCH_LDFLAGS := --defsym=__ia64_compile_only_profile=0
else ifeq ($(IA64_FP_PROFILE),compile-only)
    ARCH_CFLAGS := -mlittle-endian -mconstant-gp -mfixed-range=f2-f5,f16-f31 -Wa,-xexplicit
    ARCH_LDFLAGS := --defsym=__ia64_compile_only_profile=1
else
    $(error Unsupported IA64_FP_PROFILE '$(IA64_FP_PROFILE)' (expected runtime or compile-only))
endif

ASFLAGS := -mlp64 -mle -mconstant-gp -xexplicit
LINKER_SCRIPT_FLAG := -T
# The kernel is freestanding but still needs GCC's integer arithmetic helpers.
# The build wrapper resolves this from the selected target compiler unless an
# explicit IA64_RUNTIME_LIBGCC archive is supplied.
IA64_RUNTIME_LIBGCC ?= $(shell $(CXX) -print-libgcc-file-name)
LIBS := $(IA64_RUNTIME_LIBGCC)

# Target information
ARCH_BITS := 64
ARCH_NAME := Itanium (IA-64)
