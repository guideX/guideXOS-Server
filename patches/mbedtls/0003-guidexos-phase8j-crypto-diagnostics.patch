+    if (A->s < 0 && mbedtls_mpi_cmp_int(R, 0) != 0) {
+        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_mpi(R, N, R));
+    }
+    R->s = 1;
 
+cleanup:
+    mbedtls_mpi_free(&T);
+    return ret;
+}
 
