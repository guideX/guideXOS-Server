+/* Reduce an MPI without entering the generic long-division correction loop.
+ * The bare-metal ECDSA path uses this for values no larger than twice the
+ * curve order. The input is copied first because the ECDSA callers commonly
+ * use the same MPI for input and output. The iteration count depends only on
+ * the allocated input size, not on its value. */
+static int ecdsa_mod_fixed(mbedtls_mpi *R,
+                           const mbedtls_mpi *A,
+                           const mbedtls_mpi *N)
+{
+    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
+    mbedtls_mpi T;
+    size_t pos;
 
+    mbedtls_mpi_init(&T);
 
+    if (mbedtls_mpi_cmp_int(N, 0) <= 0) {
+        ret = MBEDTLS_ERR_MPI_BAD_INPUT_DATA;
+        goto cleanup;
+    }
 
+    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&T, A));
+    T.s = 1;
+    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(R, N->n + 1));
+    MBEDTLS_MPI_CHK(mbedtls_mpi_lset(R, 0));
 
+    for (pos = T.n * sizeof(mbedtls_mpi_uint) * 8u; pos > 0; --pos) {
+        MBEDTLS_MPI_CHK(mbedtls_mpi_shift_l(R, 1));
+        if (mbedtls_mpi_get_bit(&T, pos - 1) != 0) {
+            MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(R, R, 1));
+        }
+        if (mbedtls_mpi_cmp_mpi(R, N) >= 0) {
+            MBEDTLS_MPI_CHK(mbedtls_mpi_sub_mpi(R, R, N));
